@page "/"
@using FlagTeacher.Web.Client.Components
@using FlagTeacher.Web.Client.Models
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Flag Teacher</PageTitle>

<aside class="stats">
    <span>Runde: @round</span>
    <span class="correct">Richtig: @correctCount</span>
    <span class="wrong">Falsch: @wrongCount</span>
</aside>

<main class="game">
    <h1>Welches Land ist das?</h1>

    @if (loadError is not null)
    {
        <p class="message wrong">@loadError</p>
    }
    else
    {
        @if (current is null)
        {
            <p>Lädt …</p>
        }
        else
        {
            <img class="flag @(flagEnlarged ? "enlarged" : null)" src="@current.FlagUrl"
                 alt="Flagge eines unbekannten Landes" @ref="flag"
                 title="@(flagEnlarged ? "Flagge verkleinern" : "Flagge vergrößern")"
                 @onclick="() => flagEnlarged = !flagEnlarged" />
        }
    }

    @if (loadError is null && current is not null)
    {
        <div class="guess">
            <div class="autocomplete @(isOpen && Matches.Count > 0 ? "open" : null)">
                <input class="picker" placeholder="Land auswählen …" autocomplete="off"
                       disabled="@(state != GameState.Guessing)"
                       value="@selectedName" @oninput="OnInput" @onkeydown="OnKeyDown"
                       @onfocus="Open" @onclick="OpenList" @onblur="Close"
                       @onkeydown:preventDefault="preventDefault" @ref="picker" />
                @if (isOpen && Matches.Count > 0)
                {
                    <ul class="suggestions" role="listbox">
                        @for (var i = 0; i < Matches.Count; i++)
                        {
                            var match = Matches[i];
                            <li role="option" class="@(i == highlighted ? "active" : null)"
                                @onmousedown="() => Choose(match)"
                                @onmousedown:preventDefault>@match.Name</li>
                        }
                    </ul>
                }
            </div>
            @if (state == GameState.Wrong && !nameCorrect && SelectedCountry is { } guessed)
            {
                <img class="guessed-flag" src="@guessed.FlagUrl" alt="Flagge von @guessed.Name"
                     title="Flagge von @guessed.Name" />
            }
        </div>

        @if (state == GameState.Correct)
        {
            <p class="message correct">Richtig!</p>
        }
        else if (state == GameState.Wrong)
        {
            <p class="message wrong">@WrongMessage</p>
            <button class="action" @onclick="NextRoundAsync" @ref="continueButton">Weiter</button>
        }
    }

    @if (loadError is null && countries.Count > 0)
    {
        <WorldMap @ref="map" Loaded="OnShapesLoaded" SelectionChanged="OnMapSelected" />
    }

    @if (loadError is null && current is not null && state == GameState.Guessing)
    {
        <button class="action" disabled="@(!CanGuess)" @onclick="GuessAsync">Raten</button>
    }
</main>

@code {
    private enum GameState { Guessing, Correct, Wrong }

    private List<Country> countries = [];
    private Country? current;
    private string selectedName = "";
    private GameState state;
    private string? loadError;
    private ElementReference picker;
    private ElementReference continueButton;
    private ElementReference flag;
    private bool flagEnlarged;
    private IJSObjectReference? pageModule;
    private bool focusPicker;
    private bool focusContinue;
    private bool isOpen;
    private int round;
    private int correctCount;
    private int wrongCount;
    private bool preventDefault;
    private int highlighted;
    private WorldMap? map;
    private HashSet<string> shapeCodes = [];
    private string? mapSelected;
    private bool nameCorrect;
    private bool mapCorrect;

    private Country? PickedOnMap => countries.FirstOrDefault(c => c.Code == mapSelected);

    private bool CanGuess => SelectedCountry is not null && mapSelected is not null;

    private string WrongMessage
    {
        get
        {
            var owners = FlagOwners;
            var names = owners.Count switch
            {
                1 => owners[0].Name,
                _ => $"{string.Join(", ", owners.SkipLast(1).Select(c => c.Name))} oder {owners[^1].Name}",
            };
            return (nameCorrect, mapCorrect, owners.Count > 1) switch
            {
                (true, false, false) => $"Falsch! Das Land stimmt, aber auf der Karte hast du das falsche Land gewählt. Richtig ist das grün markierte Land ({names}).",
                (true, false, true) => $"Falsch! Das Land stimmt, aber auf der Karte hast du ein falsches Land gewählt. Richtig sind die grün markierten Länder ({names}).",
                (false, true, _) => $"Falsch! Auf der Karte hast du ein richtiges Land gewählt, aber die Flagge gehört zu {names}.",
                _ => $"Falsch! Das ist die Flagge von {names}.",
            };
        }
    }

    // Every country with the current flag, any of which is a correct answer. The one the player answered
    // with comes first, so the map zooms to it.
    private List<Country> FlagOwners => countries
        .Where(c => current!.SharesFlagWith(c.Code))
        .DistinctBy(c => c.Code)
        .OrderByDescending(c => c.Code == mapSelected)
        .ThenByDescending(c => c == SelectedCountry)
        .ThenByDescending(c => c == current)
        .ToList();

    private Country? SelectedCountry =>
        countries.FirstOrDefault(c => string.Equals(c.Name, selectedName, StringComparison.OrdinalIgnoreCase));

    private List<Country> Matches => string.IsNullOrWhiteSpace(selectedName)
        ? countries
        : countries
            .Where(c => c.Name.Contains(selectedName.Trim(), StringComparison.CurrentCultureIgnoreCase))
            .OrderByDescending(c => c.Name.StartsWith(selectedName.Trim(), StringComparison.CurrentCultureIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            countries = await Http.GetFromJsonAsync<List<Country>>("data/countries.json") ?? [];
            if (countries.Count == 0)
            {
                loadError = "Keine Länder verfügbar.";
                return;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            loadError = "Die Länderliste konnte nicht geladen werden.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPicker)
        {
            focusPicker = false;
            await picker.FocusAsync();
        }
        else if (focusContinue)
        {
            focusContinue = false;
            // Let the Enter key press that submitted the guess finish first; otherwise its
            // keypress lands on the freshly focused button and clicks it immediately.
            await Task.Delay(150);
            // Don't let the focus undo the scroll back to the flag.
            await continueButton.FocusAsync(preventScroll: true);
        }
    }

    private async Task OnShapesLoaded(IReadOnlyCollection<string> codes)
    {
        shapeCodes = [.. codes];
        if (!countries.Any(c => shapeCodes.Contains(c.Code)))
        {
            loadError = "Keine Länder verfügbar.";
            return;
        }
        await NextRoundAsync();
    }

    private void OnMapSelected(string? code) => mapSelected = code;

    private void OnInput(ChangeEventArgs e)
    {
        selectedName = e.Value?.ToString() ?? "";
        highlighted = 0;
        isOpen = true;
    }

    private void Open() => isOpen = !string.IsNullOrWhiteSpace(selectedName);

    // A tap or click shows the whole list even when nothing is typed yet; a phone has no arrow keys to open it.
    private void OpenList() => isOpen = true;

    private void Close() => isOpen = false;

    private void Choose(Country country)
    {
        selectedName = country.Name;
        isOpen = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        preventDefault = false;
        var matches = Matches;
        switch (e.Key)
        {
            case "ArrowDown" when matches.Count > 0:
                preventDefault = true;
                isOpen = true;
                highlighted = Math.Min(highlighted + 1, matches.Count - 1);
                break;
            case "ArrowUp" when matches.Count > 0:
                preventDefault = true;
                highlighted = Math.Max(highlighted - 1, 0);
                break;
            case "Escape":
                isOpen = false;
                break;
            case "Enter" when isOpen && matches.Count > 0:
                Choose(matches[Math.Min(highlighted, matches.Count - 1)]);
                await CloseKeyboardAsync();
                break;
            case "Enter" when CanGuess:
                await GuessAsync();
                break;
            case "Enter":
                await CloseKeyboardAsync();
                break;
        }
    }

    private async Task NextRoundAsync()
    {
        // Only countries with an outline can be answered on the map.
        var playable = countries.Where(c => shapeCodes.Contains(c.Code)).ToList();
        Country next;
        do
        {
            next = playable[Random.Shared.Next(playable.Count)];
        } while (playable.Count > 1 && next == current);

        current = next;
        round++;
        selectedName = "";
        mapSelected = null;
        isOpen = false;
        highlighted = 0;
        state = GameState.Guessing;
        focusPicker = true;
        if (map is not null)
        {
            await map.ResetAsync();
        }
    }

    private async Task GuessAsync()
    {
        var guess = SelectedCountry;
        if (guess is null || mapSelected is null || current is null || map is null)
        {
            return;
        }

        nameCorrect = current.SharesFlagWith(guess.Code);
        mapCorrect = current.SharesFlagWith(mapSelected);

        await ScrollToFlagAsync();

        if (nameCorrect && mapCorrect)
        {
            state = GameState.Correct;
            correctCount++;
            StateHasChanged();
            await map.RevealAsync(FlagOwners, PickedOnMap);
            await Task.Delay(TimeSpan.FromSeconds(2));
            await NextRoundAsync();
        }
        else
        {
            state = GameState.Wrong;
            wrongCount++;
            focusContinue = true;
            StateHasChanged();
            await map.RevealAsync(FlagOwners, PickedOnMap, countries);
        }
    }

    // On small screens the map is often scrolled into view while guessing, hiding the flag.
    private async Task ScrollToFlagAsync() =>
        await (await PageModuleAsync()).InvokeVoidAsync("scrollToTopUnlessVisible", flag);

    // On a phone the next step is the map, which the keyboard would cover.
    private async Task CloseKeyboardAsync() => await (await PageModuleAsync()).InvokeVoidAsync("closeKeyboard");

    private async Task<IJSObjectReference> PageModuleAsync() =>
        pageModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");

    public async ValueTask DisposeAsync()
    {
        if (pageModule is not null)
        {
            try
            {
                await pageModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
