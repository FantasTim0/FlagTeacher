@using FlagTeacher.Web.Client.Models
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="world-map" @ref="element"></div>

@code {
    private ElementReference element;
    private IJSObjectReference? module;
    private DotNetObjectReference<WorldMap>? self;

    /// <summary>Raised once the outlines are loaded, with the codes of all selectable countries.</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<string>> Loaded { get; set; }

    /// <summary>Raised when the user picks a country on the map, or null when the pick is cleared.</summary>
    [Parameter] public EventCallback<string?> SelectionChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/worldMap.js");
        self = DotNetObjectReference.Create(this);
        var codes = await module.InvokeAsync<string[]>("init", element, self, "data/country-shapes.geojson");
        await Loaded.InvokeAsync(codes);
    }

    [JSInvokable]
    public Task OnCountryClicked(string? code) => SelectionChanged.InvokeAsync(code);

    /// <summary>Clears the selection and unlocks the map for a new round.</summary>
    public async Task ResetAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("reset");
        }
    }

    /// <summary>
    /// Locks the map, highlights the correct countries and marks a wrong pick, all labeled with their names.
    /// The map zooms to the first correct country. When <paramref name="allCountries"/> is given, every other
    /// country gets a plain name label too.
    /// </summary>
    public async Task RevealAsync(IReadOnlyList<Country> correct, Country? picked, IEnumerable<Country>? allCountries = null)
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("reveal", correct.Select(c => new[] { c.Code, c.Name }), picked?.Code, picked?.Name,
                allCountries?.DistinctBy(c => c.Code).ToDictionary(c => c.Code, c => c.Name));
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("destroy");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        self?.Dispose();
    }
}
